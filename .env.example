# Kaplan Solutions — lokale Konfiguration (nicht committen!)
# Kopieren: cp .env.example .env

# E-Mail (von Render übernehmen)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Kaplan Solutions <kontakt@kaplan-solutions.de>
# Reply-To / Empfang (Resend Inbound — kein Strato-Postfach nötig)
REPLY_EMAIL=kontakt@kaplan-solutions.de
CONTACT_EMAIL=kontakt@kaplan-solutions.de
ADMIN_EMAIL=Kawa.f.Kaplan@gmail.com
# Eingehende Mails zusätzlich an Gmail + Assistent-Briefing (1=an, 0=aus)
INBOX_FORWARD_GMAIL=1

# Google Places — Firmen finden (Google Cloud Console → Places API)
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxx

# Firmendaten (optional, für Signatur)
# legal_form: privat | einzelunternehmen | gmbh
COMPANY_LEGAL_FORM=privat
COMPANY_OPERATOR=
COMPANY_STREET=Hochstraße 8
COMPANY_ZIP=13357
COMPANY_CITY=Berlin
COMPANY_PHONE=+49 159 01309199
COMPANY_WEBSITE=https://kaplan-solutions.de

# Outreach-Limits (optional)
OUTREACH_DAILY_LIMIT=80
OUTREACH_DISCOVER_LIMIT=200
OUTREACH_ENRICH_BATCH=30
OUTREACH_SEND_BATCH=8
OUTREACH_DISCOVER_BATCH=3
OUTREACH_INTERVAL=300
OUTREACH_REPORT_EMAIL=Kawa.f.Kaplan@gmail.com
OUTREACH_REPORT_HOUR=18
OUTREACH_REPORT_FINAL_HOUR=20
# Zuverlässigkeit: Mac wach halten + Nachholversand nach Sleep
OUTREACH_CAFFEINATE=1
OUTREACH_WAKE_CATCHUP=1
OUTREACH_HOUR_START=7
OUTREACH_HOUR_END=18
OUTREACH_FLUSH_HOUR=17
OUTREACH_ENRICH_CUTOFF_HOUR=17
OUTREACH_REFERRAL_QUEUE_BOOST=12
OUTREACH_BAUHERR_QUEUE_BOOST=8
OUTREACH_WEEKDAYS_ONLY=1
OUTREACH_MORNING_REPORT_HOUR=8
OUTREACH_MORNING_REPORT_EMAIL=Kawa.f.Kaplan@gmail.com
OUTREACH_MIDDAY_REPORT_HOUR=13
OUTREACH_MIDDAY_REPORT_EMAIL=Kawa.f.Kaplan@gmail.com
OUTREACH_ALERT_EMAIL=Kawa.f.Kaplan@gmail.com
# Intro-Mail: Partner muss Vertrag=Ja im CRM haben, sonst Entwurf an Admin
INTRO_CC_ADMIN=1
# Rechnung: auto bei Stage „Auftrag über Vermittlung“ + Netto € + Vertrag=Ja
# Outreach → Google Sheet (Matching-Portfolio)
OUTREACH_SHEET_SYNC=1
OUTREACH_SHEET_SYNC_BATCH=5
# Mac → Kaplan Sales CRM: Outreach-Live-Dashboard auf Render (CRON_SECRET nötig)
OUTREACH_LIVE_SYNC=1
OUTREACH_LIVE_SYNC_INTERVAL=60
OUTREACH_REMINDER_DAYS=3
OUTREACH_REMINDER_BATCH=5
# Referral-Outreach: Makler, Architekten, Projektentwickler (B2B)
OUTREACH_REFERRAL_ENABLED=1
OUTREACH_REFERRAL_DAILY_LIMIT=20
OUTREACH_REFERRAL_DISCOVER_LIMIT=100
OUTREACH_REFERRAL_SEND_BATCH=4
OUTREACH_REFERRAL_DISCOVER_BATCH=2
OUTREACH_REFERRAL_TRADES=Immobilienmakler,Architekturbüro,Projektentwickler,Immobilienverwaltung,Bauplanungsbüro,Ingenieurbüro Tragwerksplanung,Statik Büro
# Bauherr-Outreach: Projektentwickler, Bauträger (potenzielle Auftraggeber)
OUTREACH_BAUHERR_ENABLED=1
OUTREACH_BAUHERR_DAILY_LIMIT=15
OUTREACH_BAUHERR_DISCOVER_LIMIT=60
OUTREACH_BAUHERR_SEND_BATCH=3
OUTREACH_BAUHERR_DISCOVER_BATCH=2
OUTREACH_BAUHERR_TRADES=Projektentwickler,Bauträger,Immobilienentwickler,Ingenieurbüro Bau,Generalplaner,Projektsteuerer Bau

# Projekt-Ausschreibung Duisburg (Auftragnehmer in der Region)
OUTREACH_PROJEKT_SEND_ENABLED=1
OUTREACH_PROJEKT_DAILY_LIMIT=95
OUTREACH_PROJEKT_DISCOVER_LIMIT=800
OUTREACH_DAILY_LIMIT=0
OUTREACH_REFERRAL_ENABLED=0
OUTREACH_BAUHERR_ENABLED=0

# Städte-Fokus (Komma-getrennt). Berlin-Region + Metropolen = schnelles Portfolio.
# Leer lassen = deutschlandweit.
OUTREACH_FOCUS_CITIES=Berlin,Potsdam,Cottbus,Brandenburg an der Havel,Hamburg,München,Köln,Frankfurt am Main,Leipzig,Dresden,Hannover,Düsseldorf,Stuttgart,Nürnberg,Bremen,Bonn,Münster,Karlsruhe,Magdeburg,Rostock,Kiel,Wiesbaden

# Lead-Follow-up: automatische Antwort am Folgetag (Europe/Berlin)
LEAD_FOLLOWUP_HOUR=8
LEAD_DIGEST_HOUR=9
LEAD_DIGEST_FALLBACK_HOUR=10
LEAD_DIGEST_GRACE_MINUTES=15
LEAD_DIGEST_EMAIL=Kawa.f.Kaplan@gmail.com
LEAD_AGENT_NAME=Kaplan Solutions · Partnervermittlung
LEAD_FOLLOWUP_RETRIES=3

# Google Sheets Matching (Apps Script Webhook-URL mit /exec)
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_WEBHOOK_TIMEOUT=90
SHEETS_WEBHOOK_RETRIES=3
MATCH_RESCAN_INTERVAL=3600
MATCH_BRIEFING_HOUR=10
MATCH_BRIEFING_EMAIL=Kawa.f.Kaplan@gmail.com
# Sofort-Alert bei Match >= 75% (Admin + Bauherr)
MATCH_ALERT_MIN_SCORE=75
# Gleicher Wert in Google Sheet _Meta B6 eintragen
MATCH_ALERT_SECRET=
# Gleicher Wert in Google Sheet _Meta B7 (crm_secret) eintragen
ADMIN_CRM_SECRET=
# Optional: Secret für Cron-Endpoint /api/cron/lead-followups
CRON_SECRET=

# Google Ads — Conversion-Tracking (nur nach Cookie-Zustimmung)
# GOOGLE_ADS_ID=AW-XXXXXXXXX
# GOOGLE_ADS_CONVERSION=AW-XXXXXXXXX/AbCdEfGhIjKlMnOpQr


# Provisionsmodell (AGB / Vermittlungsvertrag)
PROVISION_PARTNER_PERCENT=5.0
PROVISION_PARTNER_MIN_EUR=1500
PROVISION_PARTNER_MAX_EUR=30000
PROVISION_PARTNER_FOLLOWUP_MONTHS=12
PROVISION_BAUHERR_PERCENT=0
PROVISION_BAUHERR_MIN_EUR=0
PROVISION_BERATUNG_EUR=0

# Optional: Deploy Hook URL aus Render → Settings → Deploy Hook
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-...

